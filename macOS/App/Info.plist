<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleDisplayName</key><string>ParaAir</string>
<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
<key>CFBundleName</key><string>ParaAir</string>
<key>CFBundleIconFile</key><string>ParaAir</string>
<key>CFBundleIconName</key><string>ParaAir</string>
<key>ParaAirUseNativeMount</key><true/>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
<key>LSMinimumSystemVersion</key><string>$(MACOSX_DEPLOYMENT_TARGET)</string>
<key>LSUIElement</key><true/>
<key>NSPrincipalClass</key><string>NSApplication</string>
<!-- Sparkle updates. The feed and every archive must be signed with the EdDSA key whose public half is below
     (scripts/make-appcast.py signs both); the private half lives only in the release Mac's Keychain. -->
<key>SUFeedURL</key><string>https://paraair.pages.dev/appcast.xml</string>
<key>SUPublicEDKey</key><string>HpGstTaS4gNQJZIMx59SZgF/8fB+nz1vFQlAweISSX4=</string>
<key>SURequireSignedFeed</key><true/>
<key>SUVerifyUpdateBeforeExtraction</key><true/>
<key>SUEnableAutomaticChecks</key><true/>
<key>SUScheduledCheckInterval</key><integer>86400</integer>
<key>SUAutomaticallyUpdate</key><false/>
</dict></plist>
